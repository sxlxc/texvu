{
  "name": "texvu",
  "version": "0.1.0",
  "description": "A lightweight local PDF.js viewer with SyncTeX and automatic reloads for LaTeX workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sxlxc/texvu.git"
  },
  "homepage": "https://github.com/sxlxc/texvu#readme",
  "bugs": {
    "url": "https://github.com/sxlxc/texvu/issues"
  },
  "keywords": ["latex", "pdf", "pdfjs", "synctex", "viewer"],
  "type": "module",
  "bin": {
    "texvu": "src/cli.js"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "contrib",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "check": "node --check src/cli.js && node --check src/server.js && node --check src/synctex.js",
    "test": "npm run check",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
